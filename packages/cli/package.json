{
  "name": "@kintsugi/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "bin": { "kintsugi": "dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@kintsugi/domain": "workspace:*",
    "@kintsugi/harness-sdk": "workspace:*",
    "@kintsugi/harness-hub": "workspace:*",
    "@kintsugi/kintsugi-client": "workspace:*",
    "@napi-rs/keyring": "2.0.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.19.0",
    "vitest": "^5.0.3"
  }
}
