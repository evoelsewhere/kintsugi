{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "kintsugi hook session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "kintsugi hook guard-write" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "kintsugi hook activity" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "kintsugi hook session-end" }
        ]
      }
    ]
  }
}
