{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kintsugi.invalid/schemas/member-review-report-v1.json",
  "title": "Kintsugi Member Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "projectId", "unitId", "reviewId", "generation", "currentness", "verdict",
    "reviewedHead", "reviewedBase", "mergeBase", "contextRevision", "policyRevision", "agentVersion", "coverage", "findings"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "unitId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9][a-z0-9-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[a-z0-9][a-z0-9-]{0,62}$" },
    "reviewId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "generation": { "type": "integer", "minimum": 1 },
    "currentness": { "enum": ["current", "superseded", "inconclusive"] },
    "verdict": { "enum": ["pass", "fail", "inconclusive"] },
    "reviewedHead": { "$ref": "#/$defs/sha" },
    "reviewedBase": { "$ref": "#/$defs/sha" },
    "mergeBase": { "$ref": "#/$defs/sha" },
    "contextRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "policyRevision": { "type": "string", "minLength": 1, "maxLength": 512 },
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 512 },
    "coverage": { "enum": ["complete", "partial"] },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "coverage": { "const": "partial" } }, "required": ["coverage"] },
      "then": { "properties": { "verdict": { "enum": ["fail", "inconclusive"] } } }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path", "startLine"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "severity", "title", "rationale", "repairGuidance", "citation", "currentness"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "repairGuidance": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "citation": { "$ref": "#/$defs/citation" },
        "currentness": { "enum": ["current", "superseded"] }
      }
    }
  }
}
