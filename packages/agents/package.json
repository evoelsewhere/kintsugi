{
  "name": "@kintsugi/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reader": {
      "types": "./dist/reader/index.d.ts",
      "import": "./dist/reader/index.js"
    }
  },
  "files": [
    "dist",
    "builtin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p builtin/tsconfig.reader.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p builtin/tsconfig.json && tsc -p builtin/tsconfig.reader.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kintsugi/domain": "workspace:*",
    "@kintsugi/runtime-sdk": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@kintsugi/runtime": "workspace:*",
    "@types/node": "^22.19.0",
    "vitest": "^5.0.3"
  }
}
