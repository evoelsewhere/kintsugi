//INVJOB   JOB (BILL),'NIGHTLY INVOICES',CLASS=A,MSGCLASS=X
//*  NIGHTLY INVOICE RUN
//STEP010  EXEC PGM=INVBATCH
//STEPLIB  DD DSN=BILL.PROD.LOADLIB,DISP=SHR
//ORDERS   DD DSN=BILL.PROD.ORDERS.DAILY,DISP=SHR
//CUSTMAST DD DSN=BILL.PROD.CUSTMAST,DISP=SHR
//CTLFILE  DD DSN=BILL.PROD.CONTROL(INVOUT),DISP=SHR
//REJECTS  DD DSN=BILL.PROD.REJECTS(+1),DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5))
//INVOICES DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
