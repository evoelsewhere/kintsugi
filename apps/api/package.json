{
  "name": "@kintsugi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kintsugi/domain": "workspace:*",
    "@kintsugi/runtime": "workspace:*",
    "@kintsugi/runtime-sdk": "workspace:*",
    "@kintsugi/secrets": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.3"
  }
}
