{
  "name": "@kintsugi/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-telemetry": "1.3.0",
    "@kintsugi/domain": "workspace:*",
    "@kintsugi/runtime-sdk": "workspace:*",
    "@kintsugi/secrets": "workspace:*",
    "pg": "^8.23.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider-catalog": {
      "types": "./dist/catalog/provider-catalog.d.ts",
      "import": "./dist/catalog/provider-catalog.js"
    },
    "./tool-names": {
      "types": "./dist/kernel/tool-names.d.ts",
      "import": "./dist/kernel/tool-names.js"
    },
    "./launcher": {
      "types": "./dist/launcher/index.d.ts",
      "import": "./dist/launcher/index.js"
    },
    "./mcp-probe": {
      "types": "./dist/catalog/mcp-probe.d.ts",
      "import": "./dist/catalog/mcp-probe.js"
    }
  }
}
