{
  "name": "@kintsugi/harness-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
