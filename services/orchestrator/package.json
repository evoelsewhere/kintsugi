{
  "name": "@kintsugi/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./queues": {
      "types": "./dist/queues.d.ts",
      "import": "./dist/queues.js"
    },
    "./stages": {
      "types": "./dist/jobs/stages.d.ts",
      "import": "./dist/jobs/stages.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "import": "./dist/outbox/index.js"
    },
    "./project-memory": {
      "types": "./dist/project-memory/index.d.ts",
      "import": "./dist/project-memory/index.js"
    },
    "./web-search": {
      "types": "./dist/web-search/index.d.ts",
      "import": "./dist/web-search/index.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "dev": "node ../../scripts/dev-service.mjs"
  },
  "dependencies": {
    "@kintsugi/agents": "workspace:*",
    "@kintsugi/domain": "workspace:*",
    "@kintsugi/git": "workspace:*",
    "@kintsugi/manifest": "workspace:*",
    "@kintsugi/runtime": "workspace:*",
    "@kintsugi/runtime-sdk": "workspace:*",
    "@kintsugi/secrets": "workspace:*",
    "cheerio": "1.1.2",
    "pg": "^8.23.1",
    "pg-boss": "12.37.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.3"
  }
}
