FROM node:22-trixie-slim AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @kintsugi/orchestrator... build

FROM python:3.12-slim-trixie AS python-runtime

FROM node:22-trixie-slim

ENV NODE_ENV=production \
    KINTSUGI_PYTHON=/usr/local/bin/python3.12 \
    KINTSUGI_NODE=/usr/local/bin/node

RUN groupadd --system --gid 10001 kintsugi \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --no-create-home kintsugi \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=python-runtime /usr/local/ /usr/local/
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/ /app/
USER 10001:10001

CMD ["node", "services/orchestrator/dist/main.js"]
