# --- Kintsugi installation ---
KINTSUGI_VERSION=latest
# Container registry hosting the Kintsugi images
KINTSUGI_REGISTRY=registry.example.com/kintsugi
KINTSUGI_HTTP_PORT=8080
KINTSUGI_PUBLIC_URL=https://kintsugi.example.internal

# Master key for encrypting secrets (LLM keys, Git tokens) in Postgres. Generate: openssl rand -base64 32
KINTSUGI_SECRET_KEY=

# First admin account (ADR-0008). Required on first start (at least 8 characters; there is
# no default). Change the password after first login.
KINTSUGI_BOOTSTRAP_ADMIN_USER=admin
KINTSUGI_BOOTSTRAP_ADMIN_PASSWORD=

# --- Database ---
POSTGRES_PASSWORD=

# --- Git ---
# Host directory for Git mirrors, workspace clones and per-job checkouts (ADR-0025). Required.
# Size it for every registered repository plus running jobs.
KINTSUGI_DATA_DIR=/srv/kintsugi/data
# Git servers and repositories are configured in the portal (Settings → Git), any number of each.
# Polling interval when webhooks cannot reach this installation (D30)
KINTSUGI_GIT_POLL_INTERVAL=180

# --- Runtime jobs ---
KINTSUGI_JOB_MAX_CONCURRENCY=2
KINTSUGI_JOB_DEFAULT_TIMEOUT=1800
KINTSUGI_JOB_MEMORY=4g
KINTSUGI_JOB_CPUS=2
# Set to runsc if gVisor is installed on the host
KINTSUGI_JOB_DOCKER_RUNTIME=


# LLM providers for the runtime are configured in the portal (Admin → LLM Providers), not here.
